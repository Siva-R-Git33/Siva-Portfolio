{
    "buildCommand": "npm run build",
    "installCommand": "npm install && chmod +x node_modules/.bin/vite",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/supabase/(.*)",
            "destination": "/api/supabase"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}